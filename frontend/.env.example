# GenLayer StudioNet contract address after deployment (chain 61999).
NEXT_PUBLIC_CONSENSUS_NOIR_CONTRACT=

# Optional: override the StudioNet upstream and wallet network RPC.
# Defaults to https://studio.genlayer.com/api
NEXT_PUBLIC_GENLAYER_RPC=

# Optional server-only upstream used by the same-origin RPC relay.
# Browsers use /api/genlayer by default so RPC rate-limit responses cannot be
# turned into opaque CORS failures.
GENLAYER_RPC_URL=
